      "kind": "short",
      "front": "Why is n(n−1)(n+1) divisible by 6 for every integer n?",
      "back": "n(n−1)(n+1); among three consecutive integers, one is even and one is a multiple of 3.",
      "accept": [
        "n(n−1)(n+1); among three consecutive integers, one is even and one is a multiple of 3.",
        "n(n-1)(n+1) has a factor of 2 and a factor of 3.",
        "Three consecutive integers include an even number and a multiple of 3.",
        "One of three consecutive integers is divisible by 2 and one by 3.",
        "A factor is even and a factor is divisible by 3.",
        "The product contains factors of 2 and 3.",
        "The consecutive factors give both 2 and 3."
      ],
      "reject": [
        "All three factors are multiples of 6.",
        "n³−n is only divisible by 3.",
        "Each factor must individually be divisible by 6.",
        "Having a factor of 3 alone proves divisibility by 6."
      ],
      "strictRecall": true
    },
