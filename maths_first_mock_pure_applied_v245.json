      "kind": "short",
      "front": "Why is n²−n even for every integer n?",
      "back": "n²−n = n(n−1), the product of two consecutive integers.",
      "accept": [
        "n²−n = n(n−1), the product of two consecutive integers.",
        "n(n−1) contains an even factor.",
        "It is the product of two consecutive integers, one even.",
        "n(n−1), and one of them is even.",
        "n(n-1), a product with an even factor.",
        "The factorisation n(n−1) includes an even integer."
      ],
      "reject": [
        "n²−n is always odd.",
        "Every integer n is even.",
        "n²−n=n(n+1)."
      ],
      "strictRecall": true
    },
