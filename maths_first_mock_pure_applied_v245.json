      "kind": "short",
      "front": "For integer n, why must n(n+1) be even?",
      "back": "One of two consecutive integers n and n+1 must be even.",
      "accept": [
        "One of two consecutive integers n and n+1 must be even.",
        "One of n or n+1 is even.",
        "Consecutive integers include an even number.",
        "The product includes an even integer.",
        "Either n or n+1 is divisible by 2.",
        "At least one of the consecutive numbers is even."
      ],
      "reject": [
        "n is always even.",
        "Both consecutive integers are even.",
        "Both factors are always even.",
        "The product is always odd."
      ],
      "strictRecall": true
    },
    {
