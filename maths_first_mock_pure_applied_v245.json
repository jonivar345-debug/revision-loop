      "front": "n³−n=n(n−1)(n+1). Why is it divisible by 3?",
      "back": "n(n−1)(n+1); one of three consecutive integers is a multiple of 3.",
      "accept": [
        "n(n−1)(n+1); one of three consecutive integers is a multiple of 3.",
        "n(n-1)(n+1), and one factor is divisible by 3.",
        "Three consecutive integers include a multiple of 3.",
        "One of n−1, n, n+1 is divisible by 3.",
        "Every three successive integers contain a multiple of 3."
      ],
      "reject": [
        "n³−n = n(n−1), which always divides by 3.",
        "All three factors are divisible by 3.",
        "All three numbers must be multiples of 3."
